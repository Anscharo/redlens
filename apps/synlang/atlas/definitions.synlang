;; A.0.1.1.26 — Governance Equilibrium
(: governance-equilibrium Term)
(term governance-equilibrium "Governance Equilibrium")
(defined-at governance-equilibrium "7e629109-1d84-46da-a986-94036be81e93")
(defined-in governance-equilibrium atlas-preamble-definitions)
(content-hash governance-equilibrium "3edae5568252d0bf05f5cda9b99acb1b1e9d10324a195bf181deffe2a074fdd2")
(definition governance-equilibrium "A Governance Equilibrium is a state in a Decentralized Governance dynamic where the governance process is able to remain decentralized over time with a very high degree of confidence. It requires redundant feedback loops that can counteract the natural incentives that push the governance process towards disequilibrium and centralization.")

;; A.0.1.1.27 — Endgame State
(: endgame-state Term)
(term endgame-state "Endgame State")
(defined-at endgame-state "8a57b601-aec4-49dc-bf34-383c63da11de")
(defined-in endgame-state atlas-preamble-definitions)
(content-hash endgame-state "3803ffaa5da3e91e4fa3c046a6553517902a8d6304af4eea6f6454dd67f77069")
(definition endgame-state "Endgame State is the final technical and alignment engineering state of Sky, in which all aspects of the ecosystem that can be made immutable, have been made immutable. The aim of the Endgame State is to create a highly resilient Governance Equilibrium.")
(mentions endgame-state alignment-engineering)
(mentions endgame-state governance-equilibrium)

;; A.0.1.1.28 — Explicit Incentives
(: explicit-incentives Term)
(term explicit-incentives "Explicit Incentives")
