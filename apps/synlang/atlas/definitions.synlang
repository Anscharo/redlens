(content-hash explicit-incentives "135c7a556d791b947d09e65fdca4a02ccb6c12bd6328d76c7bd7ebcb0525f79b")
(definition explicit-incentives "Explicit Incentives are the first-order incentives that are coded into rules in Alignment Artifacts.")
(mentions explicit-incentives alignment-artifact)

;; A.0.1.1.29 — Implicit Incentives
(: implicit-incentives Term)
(term implicit-incentives "Implicit Incentives")
(defined-at implicit-incentives "2c824e12-3ec1-4007-9294-ef15d25ccdca")
