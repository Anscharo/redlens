{
  "name": "lens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/aux/dev.mjs",
    "dev:vite": "vite",
    "build:index": "node --env-file-if-exists=.env.local scripts/required/build-index.mjs",
    "build:glossary": "node scripts/required/build-glossary.mjs",
    "build:addresses": "node --env-file-if-exists=.env.local scripts/required/build-addresses.mjs",
    "snap:chainstate": "node --env-file-if-exists=.env.local scripts/required/fetch-chain-state.mjs",
    "build:graph": "node scripts/required/build-graph.mjs",
    "build:oea-report": "bun scripts/required/build-oea-report.ts",
    "build:history": "bun scripts/required/build-history.mjs",
    "htmlhist:prepare": "bun scripts/htmlhist/prepare-html-history.mjs",
    "htmlhist:curate": "bun scripts/htmlhist/build-history-curation.mjs --auto",
    "htmlhist:resume": "bun scripts/htmlhist/auto-curate-html-history.mjs --frontier",
    "htmlhist:apply": "bun scripts/htmlhist/prepare-html-history.mjs --decisions",
    "htmlhist:audit": "bun scripts/htmlhist/audit-html-decisions.mjs",
    "htmlhist:audit:accuracy": "bun scripts/htmlhist/audit-html-history.mjs",
    "htmlhist:trace": "bun scripts/htmlhist/forward-trace-html-history.mjs",
    "prehist:genesis": "bun scripts/prehist/build-genesis.mjs",
    "prehist:mip": "bun scripts/prehist/build-mip.mjs",
    "prehist:aep": "bun scripts/prehist/apply-aep-upgrades.mjs",
    "atlas:worker": "bun scripts/required/atlas-worker.mjs",
    "build:manifest": "node scripts/required/build-manifest.mjs",
    "build:bundle": "bun scripts/required/build-bundle.ts",
    "build:tools": "bun scripts/required/build-tools.ts",
    "census:check": "node scripts/required/check-atlas-census.mjs",
    "census:govops": "node scripts/required/check-govops-census.mjs",
    "census:risk": "bun scripts/required/check-risk-census.mjs",
    "processes:check": "node scripts/required/check-processes-dirty.mjs",
    "processes:triage": "bash scripts/aux/processes-triage.sh",
    "processes:apply-decisions": "node scripts/aux/processes-apply-decisions.mjs",
    "processes:bootstrap": "node scripts/aux/processes-bootstrap.mjs",
    "oea:assess": "bun scripts/aux/assess-oea.ts",
    "risk:assess": "bun scripts/aux/assess-risk.ts",
    "eval:golden": "bun scripts/aux/eval-golden.ts",
    "eval:verifier": "bun scripts/aux/eval-verifier.ts",
    "eval:advisor": "bun scripts/aux/eval-advisor.ts",
    "eval:slices": "bun scripts/aux/eval-verifier-slices.ts",
    "eval:harness": "bun scripts/aux/eval-harness.ts",
    "eval:bakeoff": "bun scripts/aux/eval-bakeoff.ts",
    "build:at": "node --env-file-if-exists=.env.local scripts/required/build-at.mjs",
    "build:ts": "tsc -b",
    "build:vite": "vite build",
    "build": "pnpm build:index && pnpm build:glossary && pnpm build:addresses && pnpm snap:chainstate && pnpm build:graph && pnpm build:oea-report && pnpm build:manifest && pnpm build:bundle && pnpm build:tools && pnpm run build:ts && vite build",
    "start": "bun src/server/index.ts",
    "refresh:atlas-build": "bun scripts/required/refresh-atlas-build.mjs",
    "sync:atlas": "bun src/server/sync.ts",
    "sync:embeddings": "bun src/server/sync-embeddings.ts",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:migrate": "bun src/server/migrate.ts",
    "lint": "oxlint .",
    "check:patch-notes": "node scripts/required/check-patch-notes.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "bun test $(pwd)/src/server/*.test.ts $(pwd)/scripts/aux/eval-verifier-mutations.test.ts",
    "test:server:coverage": "GITHUB_CLIENT_ID=test-id GITHUB_CLIENT_SECRET=test-secret GOOGLE_CLIENT_ID=test-gid GOOGLE_CLIENT_SECRET=test-gsecret bun test $(pwd)/src/server/*.test.ts $(pwd)/src/server/**/*.test.ts $(pwd)/scripts/aux/eval-verifier-mutations.test.ts --coverage --coverage-reporter=lcov --coverage-dir=coverage/bun",
    "test:snap": "vitest run --config vitest.snap.config.ts",
    "test:snap:update": "vitest run --config vitest.snap.config.ts -u",
    "test:e2e": "playwright test",
    "check:pr": "bash scripts/aux/check-atlas-pr.sh",
    "tva": "bash scripts/aux/tva.sh",
    "knip": "knip",
    "pull-atlas": "git submodule update --init --recursive",
    "test:coverage": "vitest run --coverage",
    "coverage:areas": "node scripts/required/coverage-areas.mjs"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@posthog/ai": "8.3.0",
    "@posthog/mcp": "0.9.1",
    "@uiw/react-color": "2.10.1",
    "@xyflow/react": "12.10.2",
    "arctic": "3.7.0",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "graphology-layout-noverlap": "0.4.2",
    "graphology-traversal": "0.3.1",
    "jose": "6.2.3",
    "katex": "0.16.45",
    "minisearch": "7.2.0",
    "openai": "6.39.1",
    "posthog-js": "1.393.1",
    "posthog-node": "5.41.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "react-window": "2.2.7",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "unist-util-visit": "5.1.0",
    "wcag-contrast": "3.0.0",
    "workbox-window": "7.4.1",
    "wouter": "3.9.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@tailwindcss/vite": "4.2.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/hast": "3.0.4",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/wcag-contrast": "3.0.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "bun-types": "1.3.14",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "29.1.1",
    "knip": "6.6.0",
    "oxlint": "1.62.0",
    "tailwindcss": "4.2.2",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "6.0.2",
    "viem": "2.48.2",
    "vite": "8.0.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.5"
  },
  "pnpm": {
    "overrides": {
      "workbox-build": "7.4.1"
    }
  },
  "overrides": {
    "workbox-build": "7.4.1"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  }
}
