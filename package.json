{
  "name": "sabr-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/aux/dev.mjs",
    "dev:vite": "pnpm --filter sabr-web dev",
    "build:index": "node --env-file-if-exists=.env.local scripts/required/build-index.mjs",
    "build:glossary": "node scripts/required/build-glossary.mjs",
    "build:addresses": "node --env-file-if-exists=.env.local scripts/required/build-addresses.mjs",
    "snap:chainstate": "bun scripts/required/fetch-chain-state.mjs",
    "build:graph": "node scripts/required/build-graph.mjs",
    "build:oea-report": "bun scripts/required/build-oea-report.ts",
    "build:history": "bun scripts/required/build-history.mjs",
    "htmlhist:prepare": "bun scripts/htmlhist/prepare-html-history.mjs",
    "htmlhist:curate": "bun scripts/htmlhist/build-history-curation.mjs --auto",
    "htmlhist:resume": "bun scripts/htmlhist/auto-curate-html-history.mjs --frontier",
    "htmlhist:structural": "bun scripts/htmlhist/thread-structural.mjs",
    "htmlhist:apply": "bun scripts/htmlhist/prepare-html-history.mjs --decisions",
    "htmlhist:audit": "bun scripts/htmlhist/audit-html-decisions.mjs",
    "htmlhist:audit:accuracy": "bun scripts/htmlhist/audit-html-history.mjs",
    "htmlhist:trace": "bun scripts/htmlhist/forward-trace-html-history.mjs",
    "prehist:genesis": "bun scripts/prehist/build-genesis.mjs",
    "prehist:mip": "bun scripts/prehist/build-mip.mjs",
    "prehist:aep": "bun scripts/prehist/apply-aep-upgrades.mjs",
    "atlas:worker": "bun scripts/required/atlas-worker.mjs",
    "build:manifest": "node scripts/required/build-manifest.mjs",
    "build:bundle": "bun scripts/required/build-bundle.ts",
    "build:tools": "bun scripts/required/build-tools.ts",
    "census:check": "node scripts/required/check-atlas-census.mjs",
    "census:govops": "node scripts/required/check-govops-census.mjs",
    "census:risk": "bun scripts/required/check-risk-census.mjs",
    "census:concepts": "bun scripts/required/check-concepts-census.mjs",
    "census:chains": "bun scripts/required/check-chains-census.mjs",
    "chains:add": "node scripts/aux/add-chain.mjs",
    "settlements:parse": "node scripts/aux/parse-settlements.mjs",
    "processes:check": "node scripts/required/check-processes-dirty.mjs",
    "processes:triage": "bash scripts/aux/processes-triage.sh",
    "processes:apply-decisions": "node scripts/aux/processes-apply-decisions.mjs",
    "processes:bootstrap": "node scripts/aux/processes-bootstrap.mjs",
    "oea:assess": "bun scripts/assess/assess-oea.ts",
    "risk:assess": "bun scripts/assess/assess-risk.ts",
    "cite:check": "node scripts/aux/report-cite-check.mjs",
    "eval:golden": "bun scripts/eval/eval-golden.ts",
    "eval:verifier": "bun scripts/eval/eval-verifier.ts",
    "eval:advisor": "bun scripts/eval/eval-advisor.ts",
    "eval:slices": "bun scripts/eval/eval-verifier-slices.ts",
    "eval:harness": "bun scripts/eval/eval-harness.ts",
    "eval:wiki-ab": "bun scripts/eval/eval-wiki-ab.ts",
    "eval:bakeoff": "bun scripts/eval/eval-bakeoff.ts",
    "eval:retrieval": "bun scripts/eval/eval-retrieval.ts",
    "eval:facts": "bun scripts/eval/eval-facts.ts",
    "eval:census": "bun scripts/eval/eval-census.ts",
    "eval:complexity": "bun scripts/eval/eval-complexity.ts",
    "eval:completeness": "bun scripts/eval/eval-completeness.ts",
    "census:embed-units": "bun scripts/aux/embed-units-census.ts",
    "build:at": "node --env-file-if-exists=.env.local scripts/required/build-at.mjs",
    "build:ts": "tsc -b",
    "build:vite": "pnpm --filter sabr-web build:vite",
    "build": "pnpm build:index && pnpm build:glossary && pnpm build:addresses && pnpm build:graph && pnpm build:oea-report && pnpm build:manifest && pnpm build:bundle && pnpm build:tools && pnpm run build:ts && pnpm build:vite",
    "start": "bun src/server/index.ts",
    "refresh:atlas-build": "bun scripts/required/refresh-atlas-build.mjs",
    "sync:atlas": "bun src/server/sync.ts",
    "sync:embeddings": "bun src/server/sync-embeddings.ts",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:migrate": "bun src/server/migrate.ts",
    "lint": "oxlint .",
    "check:patch-notes": "node scripts/required/check-patch-notes.mjs",
    "check:atlas": "node scripts/required/check-atlas-parsed.mjs",
    "check:boundaries": "node scripts/required/check-boundaries.mjs",
    "check:mocks": "node scripts/aux/audit-mock-modules.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "preview": "pnpm --filter sabr-web preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "pnpm check:mocks && bun test src/server scripts/eval/eval-verifier-mutations.test.ts scripts/eval/eval-retrieval-queries.test.ts",
    "test:snap": "vitest run --config vitest.snap.config.ts",
    "test:snap:update": "vitest run --config vitest.snap.config.ts -u",
    "test:e2e": "playwright test --project=core",
    "test:e2e:canary": "playwright test --project=canary",
    "test:e2e:types": "tsc -p tsconfig.e2e.json --noEmit",
    "check:pr": "bash scripts/aux/check-atlas-pr.sh",
    "tva": "bash scripts/aux/tva.sh",
    "knip": "knip",
    "pull-atlas": "git submodule update --init --recursive",
    "test:coverage": "vitest run --coverage",
    "test:server:coverage": "pnpm check:mocks && bun test src/server scripts/eval/eval-verifier-mutations.test.ts scripts/eval/eval-retrieval-queries.test.ts --coverage --coverage-reporter=lcov --coverage-dir=coverage/bun",
    "coverage:areas": "node scripts/aux/coverage-areas.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@posthog/ai": "8.3.0",
    "@posthog/mcp": "0.9.1",
    "@resvg/resvg-js": "2.6.2",
    "@ternlight/base": "0.1.1",
    "arctic": "3.7.0",
    "graphology": "0.26.0",
    "jose": "6.2.3",
    "minisearch": "7.2.0",
    "openai": "6.39.1",
    "posthog-node": "5.41.0",
    "satori": "0.28.2",
    "viem": "2.48.2",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "24.12.2",
    "@vitest/coverage-v8": "4.1.5",
    "bun-types": "1.3.14",
    "exceljs": "4.4.0",
    "jsdom": "29.1.1",
    "knip": "6.6.0",
    "oxlint": "1.62.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "7.0.2",
    "vitest": "4.1.5"
  },
  "pnpm": {
    "overrides": {
      "workbox-build": "7.4.1"
    }
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  }
}
