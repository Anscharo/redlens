# Atlas-derived artifacts — built ephemerally at container startup / by the
# in-process updater / by the history worker. Never committed.
# Keep: public/addresses.json (Etherscan), public/chain-state.json (RPC),
#        public/processes*.json (curated), public/favicon.svg etc. (static).
public/docs.json
public/search-index.json
public/relations.json
public/graph.json
public/glossary.json
public/addresses.atlas.json
public/manifest.json
public/history/



# Intermediate handoff file from build:index → build:addresses
public/addresses.merged.json

# Vector index — built locally (transformers.js bge-base-en-v1.5).
# vectors.bin tracked via Git LFS; CI reuses this via incremental hash check.
# .cache/atlas-vectors/ is committed, not ignored.

