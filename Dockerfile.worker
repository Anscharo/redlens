# Atlas worker image — separate cron service that runs a full atlas build,
# syncs all Postgres tables (doc_meta with content, addresses, sync_state,
# history, embeddings), and exits. The web service's in-process updater then
# detects the sync_state.atlas_sha change and rebuilds in-memory indexes from
# the updated DB rows. No git access needed on the web service side.
#
# Differences from the main Dockerfile:
#   - Full (non-shallow) atlas clone: git log walking for build-history
#   - gh CLI: `gh api` for PR metadata
#   - No Vite/SPA build: worker runs scripts at runtime only
#   - OPENROUTER_API_KEY: needed for sync-embeddings (set in Railway dashboard)
FROM oven/bun:1.3

# git: walk atlas commit history + runtime git ls-remote check.
# python3: upstream sync/ tooling (compose.py etc.) for ad-hoc checks. The
#   history walk reads every layout natively via scripts/lib/atlas-git-source.mjs.
# gh: `gh api` calls for PR metadata (title, author, body).
RUN apt-get update \
 && apt-get install -y --no-install-recommends git python3 ca-certificates curl gnupg \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | gpg --dearmor -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
 && apt-get update \
 && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Deps first — cached across source-only changes.
#
# --frozen-lockfile matters here: this stage used to copy package.json ALONE and
# run a bare `bun install`, so every worker build re-resolved the whole
# transitive graph and a broken upstream release could reach the cron service
# while CI stayed green. --prod is safe because the worker's entire runtime
# closure lives in `dependencies` — enforced by `pnpm check:boundaries`, which
# treats each spawned build script as its own entry point. --filter lens keeps
# the apps/web browser bundle out of a service image entirely.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json ./apps/web/

# pnpm is the repo's only package manager. Bun stays the runtime — this image's
# start command is still `bun scripts/required/atlas-worker.mjs`. oven/bun ships
# no Node, so corepack is unavailable; pnpm's standalone build bundles its own.
#
# .npmrc turns on engine-strict and package.json pins engines.node >= 22 — a
# guard for local dev and CI, where a transitive dep needs it. pnpm's standalone
# build bundles its own Node (v20.11.1 in 10.33.0), so engine-strict measures THAT
# interpreter against a constraint meant for the dev toolchain and refuses. There
# is no Node in this image at all; the runtime here is Bun.
#
# ENV rather than an .npmrc line for two reasons: `COPY . .` lands after the
# install and would clobber an edited file, and pnpm enforces engines when it RUNS
# a script too — which `build:vite` does, delegating through
# `pnpm --filter @redlens/web`. A per-command flag covered only `pnpm install`.
ENV npm_config_engine_strict=false

ENV PNPM_HOME="/usr/local/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
# pnpm's standalone build, straight from the npm registry the install already
# needs — no third-party installer host, and the version is READ FROM
# package.json's packageManager field rather than repeated here, so the image
# and the repo cannot drift apart.
RUN set -eux; \
    ver="$(sed -n 's/.*"packageManager": *"pnpm@\([^"]*\)".*/\1/p' package.json)"; \
    test -n "$ver"; \
    case "$(dpkg --print-architecture)" in \
      amd64) pkg=linux-x64 ;; \
      arm64) pkg=linux-arm64 ;; \
      *) echo "unsupported architecture for the pnpm standalone build" >&2; exit 1 ;; \
    esac; \
    mkdir -p "$PNPM_HOME"; \
    curl -fsSL "https://registry.npmjs.org/@pnpm/${pkg}/-/${pkg}-${ver}.tgz" \
      | tar -xz -C "$PNPM_HOME" --strip-components=1 package/pnpm; \
    chmod +x "$PNPM_HOME/pnpm"; \
    pnpm --version

RUN pnpm install --frozen-lockfile --prod --filter lens \
 && rm -rf "$(pnpm store path)"

# Repo source (without node_modules/dist/.git/vendor via .dockerignore).
COPY . .

# Clone the atlas with FULL git history (not shallow) so build-history.mjs
# can walk the complete commit log. Placed after COPY . . so a lens source
# change invalidates this layer and picks up a fresh atlas clone.
RUN git clone --no-single-branch \
      https://github.com/sky-ecosystem/next-gen-atlas vendor/next-gen-atlas

# No build step — the worker runs scripts at runtime, not a compiled bundle.
