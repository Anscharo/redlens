{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["node", "vitest/globals", "vite/client"],
    "skipLibCheck": true,
    "jsx": "react-jsx",

    /* Path aliases — declared once in scripts/lib/path-aliases.mjs and asserted
       against it by scripts_tests/path-aliases.test.ts. `@/x` is root src/x;
       it survives a file moving between packages, which plain relative
       specifiers do not. */
    "paths": { "@/*": ["./src/*"] },
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/vite-env.d.ts", "scripts_tests"],
  "exclude": ["src/server"]
}
