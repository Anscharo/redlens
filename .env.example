# Generated by `pnpm env:example` from src/server/env/. Edit the declarations
# there, never this file. Copy what you need into .env.local (gitignored);
# Bun loads it automatically.

# ── Server ────────────────────────────────────────────────────────────────────

# Port the Bun server binds.
# PORT="3000"

# Public origin for OAuth redirect URIs and post-login redirects. Defaults to
# https://$RAILWAY_PUBLIC_DOMAIN, else http://localhost:$PORT. Pin it when a
# service has more than one domain, or OAuth builds its redirect URI on
# whichever domain Railway picked.
# APP_URL=""

# 301s GET and HEAD on any other host to APP_URL. Unset: on only in the Railway
# `production` environment. 1 forces it on, 0 forces it off. PR environments
# inherit production's APP_URL, so the redirect must stay off there or every PR
# deploy redirects to production.
# CANONICAL_HOST_REDIRECT=""

# Mount path of the MCP transport.
# MCP_PATH="/mcp"

# Character budget for one MCP tool response, so a single response cannot
# overflow the calling assistant's context.
# MCP_MAX_RESULT_CHARS="200000"

# Ceiling on open /api/atlas-events connections across all visitors; past it new
# connections get 503 and miss live update pushes. No capacity measurement backs
# this value yet.
# SSE_MAX_CLIENTS="500"

# ── Database and atlas sync ───────────────────────────────────────────────────

# Postgres. The default is the docker-compose service; Railway injects its own.
# DATABASE_URL="postgres://redlens:redlens@localhost:5432/redlens"

# In-process updater that rebuilds the served indexes when sync_state.atlas_sha
# moves. On unless 0 or false.
ATLAS_UPDATE_ENABLED="1"

# How often the updater polls.
# ATLAS_UPDATE_INTERVAL_MS="30000"

# Ceiling on the updater's backoff after failed rebuilds.
# ATLAS_UPDATE_MAX_BACKOFF_MS="1800000"

# Consecutive failed rebuilds before the updater logs at ERROR and freshness
# reports stuck.
# ATLAS_UPDATE_ESCALATE_AFTER="3"

# Freshness health: age of sync_state.synced_at that reports stale, meaning the
# worker has stopped. The worker touches synced_at on every run, every ~12
# minutes.
# ATLAS_STALE_SECONDS="3600"

# Freshness health: how long the served atlas may lag the database before the
# updater reports stuck.
# ATLAS_STUCK_SECONDS="1800"

# Freshness health: how long the updater loop may go without a tick before it
# reports dead.
# ATLAS_UPDATER_DEAD_SECONDS="300"

# Directory of per-sha atlas bundles. Defaults to public/atlas.
# ATLAS_BUNDLE_ROOT=""

# Bundles kept on local disk. Retention only covers loads in flight when a bump
# lands; open tabs move forward on their own.
# ATLAS_BUNDLE_KEEP="4"

# Shas kept in the shared Postgres artifact store. One more than
# ATLAS_BUNDLE_KEEP, so an instance pinned to an older sha can re-hydrate it.
# ATLAS_ARTIFACT_KEEP="5"

# ── Atlas worker and build ────────────────────────────────────────────────────

# 1 makes the worker rewalk history from the start. Leave it unset; every cycle
# then pays for the full walk.
# ATLAS_WORKER_FULL=""

# 1 builds the checked-out atlas commit instead of fetching upstream (same as
# --no-fetch).
# ATLAS_WORKER_NO_FETCH=""

# GitHub token for PR metadata in the history walk, preview resolution and
# tarball downloads.
# GITHUB_TOKEN=""

# Fallback for GITHUB_TOKEN in the worker's child processes.
# GH_TOKEN=""

# Minimum age of the stored forum cursor before the worker crawls the MSC cycle
# threads again.
# FORUM_REFRESH_SECONDS="3600"

# Model the worker's sync:briefings tail writes document briefings with, for new
# and changed documents. An empty value turns the write pass off; seed and embed
# still run.
# BRIEFING_MODEL="google/gemini-3.8-flash"

# Most documents sync:briefings writes briefings for in one worker cycle (at
# most three model requests).
# BRIEFINGS_PER_CYCLE="186"

# Time from process start after which sync:briefings starts no new model
# request.
# BRIEFINGS_DEADLINE_MS="480000"

# Atlas commit stamped into built artifacts. Defaults to the source checkout's
# HEAD.
# ATLAS_COMMIT=""

# Atlas checkout the build reads. Defaults to vendor/next-gen-atlas.
# ATLAS_SRC_DIR=""

# Directory the build writes artifacts to. Defaults to public.
# ATLAS_OUT_DIR=""

# Directory build-graph reads addresses.json from. Defaults to ATLAS_OUT_DIR.
# ATLAS_ONCHAIN_DIR=""

# check:atlas floor on the document count.
# ATLAS_MIN_DOCS="1000"

# Overrides the atlas loader's minimum node count, below which it refuses the
# checkout as truncated.
# ATLAS_MIN_NODES=""

# check:atlas --against: largest fraction of documents a bump may drop.
# ATLAS_MAX_DOC_DROP="0.1"

# 1 skips building search-index.json and deletes stale copies; the in-process
# updater sets it because it rebuilds the index itself.
# BUILD_SKIP_SEARCH_INDEX=""

# Base commit for diff-scoped checks when --base is not given. Unset: the merge
# base with origin/main.
# DIFF_BASE=""

# ── OpenRouter and semantic search ────────────────────────────────────────────

# Model and embedding calls (chat, Jev, sync:embeddings, query embeds). Unset:
# semantic search is empty and lexical search still works.
OPENROUTER_API_KEY=""

# Provisioning key for the account credits endpoint behind the chat's shared
# commons meter (OpenRouter → Settings → Provisioning Keys). The model key is
# rejected there. Unset: no commons meter and no shared-pool gate.
OPENROUTER_MANAGEMENT_KEY=""

# API base. An empty value also falls back to the default, so a blank variable
# never sends calls to api.openai.com.
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# eval files the process's spend under "Sky Atlas Redline Evals". Entry points
# under scripts/eval/ get it automatically; any other eval needs it set.
# OPENROUTER_APP_KIND=""

# Embedding model. Its dimension is fixed by the database migration, not by env.
# Every stored vector records the model that made it, so changing this re-embeds
# the corpus on the next sync, and the search bar hides the meaning lane until
# that finishes. Set the same value on the server and the atlas worker. The
# query prefix, the cosine floor and the leaf rule follow the model.
# EMBED_MODEL="google/gemini-embedding-2"

# Texts per embeddings request in sync:embeddings.
# EMBED_BATCH="50"

# Ceiling on one embed attempt, so a hung provider socket cannot park a call.
# Below about 20 s it cuts healthy batches mid-backoff. docs/DEPLOYMENT.md
# covers a dead provider.
# EMBED_REQUEST_TIMEOUT_MS="120000"

# Instruction prefix for QUERY embeds only; stored document vectors stay raw.
# Unset, it follows EMBED_MODEL: Qwen's generic retrieval instruction for a Qwen
# model, none otherwise (queryPrefixFor in config.ts). Changing it re-embeds
# nothing.
# EMBED_QUERY_PREFIX=""

# Cosine floor for semantic hits, so a query with few true matches does not fill
# top slots with unrelated neighbours. Unset, it follows EMBED_MODEL: each
# model's floor is fitted by the same rule (0.55 for gemini-embedding-2, 0.30
# for qwen3-embedding-8b).
# SEMANTIC_MIN_SCORE="0.55"

# Ceiling on the query-time embed; past it the search answers lexical-only.
# Provider p95 is 5-10 s, so a lower cap degrades many chat turns.
# SEMANTIC_EMBED_TIMEOUT_MS="10000"

# In-process LRU of query embeddings. 0 disables it.
# QUERY_EMBED_CACHE_SIZE="512"

# Shared per-minute budget for the reader's meaning lane when signed out. One
# settled search is one embedding call, so 30 carries roughly 7 people searching
# at once. 0 disables the gate. In process, so N replicas allow N times this.
# SEARCH_SEMANTIC_RPM="30"

# Each signed-in reader's own hourly budget for the meaning lane; it never draws
# on SEARCH_SEMANTIC_RPM. 600 is one search every 6 s for a whole hour. 0
# disables the gate. In process, like the shared budget.
# SEARCH_SEMANTIC_USER_PER_HOUR="600"

# ── On-chain data ─────────────────────────────────────────────────────────────

# Etherscan key for build:addresses (https://etherscan.io/apidashboard). Results
# are cached under .cache/etherscan.
ETHERSCAN_API_KEY=""

# Minimum gap between Etherscan requests, in ms (1 request a second).
# ETHERSCAN_THROTTLE_MS="1000"

# Optional key appended to Blockscout source lookups, for the chains
# build:addresses reads through Blockscout.
# BLOCKSCOUT_API_KEY=""

# Any value re-verifies cached proxy contracts, whose implementation can be
# upgraded, and rewrites the cache only when it changed.
# REFRESH_PROXY_CACHE=""

# Mainnet RPC for the chain-state multicall and ethereum balances. Unset: the
# public endpoint in scripts/lib/chains.mjs. Set it on the atlas worker when
# that endpoint rate-limits. Other chains take RPC_URL_<CHAIN>, e.g.
# RPC_URL_BASE.
# ETH_RPC_URL=""

# Pins snap:chainstate to one block instead of the latest.
# BLOCK_NUMBER=""

# Minimum age of the stored chain-state snapshot before the worker refetches it,
# so RPC spend is one multicall batch per interval, not per cycle. 86400 is
# daily, 604800 weekly.
# CHAINSTATE_REFRESH_SECONDS="86400"

# Age past which an address balance is due for the worker's rolling refresh. The
# worker looks at most once an hour and fetches one chain per look.
# BALANCES_REFRESH_SECONDS="86400"

# Most addresses one rolling balance refresh fetches. 50 stays inside one
# multicall.
# BALANCES_REFRESH_BATCH="50"

# ── Analytics (PostHog) ───────────────────────────────────────────────────────
# Cookieless and IP-free, through the first-party /z proxy. One PostHog project
# serves dev and production; every event carries host and environment
# properties.

# Build-time frontend project key (phc_…). Set: analytics on. Unset: no init, no
# /z traffic, no consent banner. Vite inlines it at build time, so set it on the
# Railway build.
VITE_POSTHOG_KEY=""

# Runtime copy of the same project key, for server-side capture: MCP tool calls,
# $ai_generation events and feedback_received. It must be a runtime service
# variable; VITE_* values never reach the running server. Unset: all server-side
# capture is a silent no-op, including the feedback alert.
POSTHOG_KEY=""

# PostHog ingest host, for EU cloud or self-hosted.
# POSTHOG_HOST="https://us.i.posthog.com"

# ── Auth (GitHub / Google OAuth + JWT session) ────────────────────────────────
# Logins turn on only when USERS_ENABLED=1 and CHAT_JWT_SECRET is set. Configure
# one provider's pair to offer only that button, or both to offer both.

# Turns on the login surface (/api/auth/*, /api/collections*).
USERS_ENABLED="1"

# Build-time twin of USERS_ENABLED that ships the login UI. The Dockerfile
# copies USERS_ENABLED into it.
VITE_USERS_ENABLED="1"

# Turns on /api/chat and /api/usage. Chat needs a logged-in session, so it also
# needs the login surface.
# CHAT_ENABLED=""

# Build-time twin of CHAT_ENABLED that ships the chat UI. The Dockerfile copies
# CHAT_ENABLED into it.
# VITE_CHAT_ENABLED=""

# GitHub OAuth App (Settings → Developer settings → OAuth Apps). Callback URL:
# <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=""

# Secret of the same OAuth App.
GITHUB_CLIENT_SECRET=""

# Google OAuth 2.0 web client (Cloud Console → APIs & Services → Credentials).
# OpenID Connect with PKCE; scopes openid, email, profile need no app
# verification. Authorized redirect URI, exact, no trailing slash:
#  <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""

# Secret of the same Google client.
GOOGLE_CLIENT_SECRET=""

# Signs the session JWT. Generate with: openssl rand -hex 32
CHAT_JWT_SECRET=""

# ── PR previews ───────────────────────────────────────────────────────────────
# Quota pools are per UTC day and count new shas only; rebuilding a known sha is
# free. Tiers are defined in src/server/preview/trust.ts.

# GitHub App (Contents: read, Metadata: read) installed on private repos, for
# private previews. Private previews also need GitHub logins. Leave both App
# variables blank to turn the feature off.
GITHUB_APP_ID=""

# PEM key of the same App. Literal \n escapes are accepted.
GITHUB_APP_PRIVATE_KEY=""

# Shared pool for canonical branches and PRs against canonical.
# PREVIEW_DAILY_QUOTA="10"

# Each trusted-tier fork owner's own pool.
# PREVIEW_TRUSTED_FORK_DAILY_QUOTA="10"

# Shared pool for known-tier forks.
# PREVIEW_FORK_DAILY_QUOTA="7"

# Shared pool for unknown-tier forks.
# PREVIEW_UNKNOWN_FORK_DAILY_QUOTA="2"

# Per-repo pool for private previews; installing the App is the trust grant.
# PREVIEW_PRIVATE_DAILY_QUOTA="20"

# Minimum GitHub account age for an unscored fork owner to get the unknown tier
# instead of being refused.
# PREVIEW_MIN_ACCOUNT_AGE_DAYS="30"

# Builds running at once across all previews.
# PREVIEW_MAX_CONCURRENT_BUILDS="2"

# Per-build timeout.
# PREVIEW_BUILD_TIMEOUT_MS="300000"

# How long a chat preview tool waits for a build it started before answering
# "still building". The build carries on either way.
# CHAT_PREVIEW_BUILD_WAIT_MS="45000"

# Cap on the whole decompressed tarball, so a fork cannot ship a decompression
# bomb. The live atlas archive is about 34 MB.
# PREVIEW_MAX_DECOMPRESSED_BYTES="67108864"

# Cap on documents in one preview build.
# PREVIEW_MAX_DOCS="20000"

# Directory of preview bundles.
# PREVIEW_DIR="/tmp/previews"

# Preview bundles kept on disk (LRU).
# PREVIEW_CACHE_KEEP="20"

# How often the sweeper applies takedowns, evicts bundles stale against main and
# enforces the LRU cap.
# PREVIEW_SWEEP_INTERVAL_MS="600000"

# How long a bundle stale against main survives, so a preview someone is
# browsing is not removed mid-session.
# PREVIEW_SWEEP_GRACE_MS="600000"

# ── Chat: models and loop ─────────────────────────────────────────────────────
# Model slots follow one convention: unset takes the default, "" turns the
# feature off. Routing and the harness are described in docs/chat-system.md.

# Primary conversationalist.
# CHAT_MODEL="google/gemma-4-31b-it"

# CSV of OpenRouter fallbacks for the default chain; unset tiers inherit it.
# CHAT_MODEL_FALLBACKS=""

# CSV: primary then fallbacks for the fast tier. Unset inherits CHAT_MODEL and
# its fallbacks.
# CHAT_MODEL_FAST=""

# CSV: primary then fallbacks for the strong tier. Unset inherits CHAT_MODEL and
# its fallbacks.
# CHAT_MODEL_STRONG=""

# Models prompted for reference-style citations. A literal list of models
# measured clean for the format, independent of CHAT_MODEL_STRONG, so swapping
# the strong tier never asks an unmeasured model for it. Every model accepts
# both formats; see docs/plans/reference-citations.md.
# CHAT_REFERENCE_CITATION_MODELS="openai/gpt-5.6-luna,openai/gpt-5-mini,openai/gpt-6-luna"

# Sampling temperature of the conversationalist. Judges stay at 0.
# CHAT_TEMPERATURE="0.3"

# Ceiling per completion request. It stops a runaway generation, not a long
# answer: exhaustive governance answers need well over 4096.
# CHAT_MAX_OUTPUT_TOKENS="16000"

# Hard cap on tool rounds. Every round replays the full context, so round count
# drives latency.
# CHAT_MAX_ITERATIONS="4"

# Tool-round cap for the strong tier, never below CHAT_MAX_ITERATIONS.
# CHAT_MAX_ITERATIONS_STRONG="6"

# Budget for one tool result fed back to the model, so one broad call cannot
# fill the context.
# CHAT_TOOL_RESULT_MAX_CHARS="30000"

# Models with a window of about 1M tokens. A turn whose whole chain is in this
# list may read large PR preview results. "" turns large reads off.
# CHAT_LARGE_CONTEXT_MODELS="openai/gpt-6-luna,openai/gpt-5.6-luna"

# Characters of large tool results one turn may read in total. 600000 is about
# 150k tokens, which keeps a turn under the 272k-token price step OpenAI models
# have on OpenRouter.
# CHAT_LARGE_READ_MAX_CHARS="600000"

# Budget for one large tool result, inside CHAT_LARGE_READ_MAX_CHARS.
# CHAT_LARGE_RESULT_MAX_CHARS="300000"

# Window the context meter and compaction use: the smallest model in the
# deployed routing chains, because a failover sends the same context. Change it
# with the chains.
# CHAT_CONTEXT_WINDOW_TOKENS="200000"

# Compacts a thread's prefix at 90% of the window. Its output is replayed for
# the rest of the thread, so it is pinned rather than following CHAT_MODEL. ""
# turns compaction off.
# CHAT_SUMMARY_MODEL="openai/gpt-6-luna"

# Ceiling on the compaction call.
# CHAT_SUMMARY_TIMEOUT_MS="60000"

# Longest stored compaction summary. The prompt's word target and the call's
# output limit follow from it.
# CHAT_SUMMARY_MAX_CHARS="15000"

# Writes 3-6 word conversation titles after assistant turns 1, 4 and 10; a
# manual rename freezes the title. "" turns titling off and keeps the first 60
# characters of the opening message.
# CHAT_TITLE_MODEL="google/gemma-4-31b-it"

# Ceiling on the titling call, which runs after the response closes, so it costs
# no latency. On timeout the existing title stays.
# CHAT_TITLE_TIMEOUT_MS="20000"

# Isolated MSC sub-agent. Unset falls back to CHAT_VERIFIER_MODEL; "" returns
# the deterministic brief without a model call.
# CHAT_EXTERNAL_SUBAGENT_MODEL=""

# Ceiling on the MSC sub-agent call.
# CHAT_EXTERNAL_SUBAGENT_TIMEOUT_MS="15000"

# Prompt and response text on PostHog $ai_generation events. On unless 0, which
# keeps only token, latency and cost metadata.
# CHAT_CAPTURE_CONTENT="1"

# Jev model for callers that name none of their own. It is not a kill switch;
# each Jev lane has its own variable.
# CHAT_JEV_MODEL="typesafe/jev-1.13"

# ── Chat: facts, routing and /teach ───────────────────────────────────────────
# Facts and the similarity lanes are documented in src/server/facts/CLAUDE.md.
# Re-run a lane's eval before moving its margin.

# The fact registry. 0 turns off every fact at once.
# CHAT_PREFETCH="1"

# The on-device embedding lane for every consumer: features, census routing,
# tier routing and the promised-tool guard. 0 leaves only the regex lanes.
# CHAT_FACT_SIMILARITY="1"

# Features lane threshold, permissive by design. Raise it (0.0, 0.15) to inject
# the guide less often.
# CHAT_FACT_SIMILARITY_MARGIN="-0.05"

# Census routing threshold, set where labeled and real-traffic false fires are
# both zero. Lower it only after `pnpm eval:census` with DATABASE_URL set.
# CHAT_CENSUS_SIMILARITY_MARGIN="0.4"

# Tier router's similarity threshold. Raise it to escalate less, lower it to
# send more whole-corpus questions to the strong tier.
# CHAT_COMPLEXITY_SIMILARITY_MARGIN="0.25"

# Promised-tool guard threshold, at the zero-false-fire point.
# CHAT_ANNOUNCEMENT_SIMILARITY_MARGIN="0.25"

# One Jev request before the first token, feeding tier routing, census routing
# and the /teach filter. "" turns it off and every lane runs its fallback.
# CHAT_PREFETCH_JUDGE_MODEL="typesafe/jev-1.13"

# Wall-clock cap on that judgement; a miss falls back to the regex and
# similarity lanes.
# CHAT_PREFETCH_JUDGE_DEADLINE_MS="600"

# Final gate on skipping the audit for pure conversation. "" turns the bypass
# off and every turn is audited.
# CHAT_SMALLTALK_JUDGE_MODEL="typesafe/jev-1.13"

# /teach notes: the command, the miss hint, injection and the system-prompt
# section. 0 turns all four off.
# CHAT_TEACH="1"

# Notes one user may teach in a day.
# CHAT_TEACH_MAX_PER_DAY="40"

# Reviews a /teach note for gibberish. Unset: the first CHAT_MODEL_STRONG model,
# else CHAT_MODEL. "" keeps only the heuristic.
# CHAT_TEACH_REVIEW_MODEL=""

# Ceiling on that review.
# CHAT_TEACH_REVIEW_TIMEOUT_MS="15000"

# ── Chat: verification ────────────────────────────────────────────────────────
# How the verifier works: src/server/chat/CLAUDE.md and docs/chat-system.md §6.

# Deterministic checks, which cost nothing. 0 turns them off.
# CHAT_VERIFY_CHECKS="1"

# Audit model, from a different family than CHAT_MODEL. "" turns model
# verification off; the deterministic checks still run.
# CHAT_VERIFIER_MODEL=""

# Per-auditor overrides, "refute=m1,overreach=m2,confirm=m3". Unnamed auditors
# use CHAT_VERIFIER_MODEL.
# CHAT_VERIFIER_SLICE_MODELS=""

# Per-auditor deadline. Auditors run concurrently after the stream, so a turn
# pays about one.
# CHAT_VERIFIER_SLICE_TIMEOUT_MS="45000"

# Evidence digest budget for the audit, newest round first.
# CHAT_VERIFIER_EVIDENCE_MAX_CHARS="120000"

# paragraph: the refute audit runs on each paragraph as it closes, catching more
# and landing sooner. answer: one call over the finished answer. Any other value
# means paragraph.
# CHAT_REFUTE_MODE="paragraph"

# Refute calls in flight per burst.
# CHAT_REFUTE_CONCURRENCY="3"

# Paragraphs past this many in one burst share one extra call; every call
# carries the full evidence, so call count drives input tokens.
# CHAT_REFUTE_MAX_PARAGRAPHS="8"

# Jev screen in front of the per-paragraph refute. shadow: recorded beside the
# audit, which still runs on every paragraph. gate: the audit runs only on
# flagged paragraphs. off: no screen.
# CHAT_REFUTE_SCREEN="shadow"

# Model of that screen.
# CHAT_REFUTE_SCREEN_MODEL="typesafe/jev-1.13"

# Judges each claim against each document it cites and marks the Sources chips.
# "" turns it off.
# CHAT_CITATION_CHECK_MODEL="typesafe/jev-1.13"

# Asks whether the answer answered every part of the question. "" turns it off.
# CHAT_ANSWER_COVERAGE_MODEL="typesafe/jev-1.13"

# Asks whether an ungrounded quoted span is presented as source wording. shadow:
# judged and recorded, severity unchanged. gate: hard-fails only at P ≥
# CHAT_QUOTE_ATTRIBUTION_MARGIN; turn it on only once the bakeoff has set the
# margin on real traffic. off: no call.
# CHAT_QUOTE_ATTRIBUTION="shadow"

# Model of that judgement.
# CHAT_QUOTE_ATTRIBUTION_MODEL="typesafe/jev-1.13"

# Gate threshold, unmeasured: 0.5 is a Noul's neutral point. Read only in gate
# mode.
# CHAT_QUOTE_ATTRIBUTION_MARGIN="0.5"

# ── Chat: limits ──────────────────────────────────────────────────────────────
# Real spend is capped by the account-wide commons pool
# (OPENROUTER_MANAGEMENT_KEY). These limits keep one user from monopolising the
# shared service.

# Input plus output tokens one user may spend per window before /api/chat
# answers 429. The default is effectively unlimited; 750000 restores a real
# per-user limit.
# RATE_LIMIT_TOKENS_PER_WINDOW="1000000000000"

# Length of the trailing token window.
# RATE_LIMIT_WINDOW_MINUTES="90"

# CSV of GitHub logins, case-insensitive, that get the boosted limit. Only the
# github provider matches.
# RATE_LIMIT_BOOST_LOGINS=""

# The boosted limit, an explicit token count so a person's limit can be read
# straight off the environment.
# RATE_LIMIT_TOKENS_PER_WINDOW_BOOSTED="3000000"

# Turns one user may have in flight. In memory, which is correct because the
# service runs as one replica.
# CHAT_MAX_CONCURRENT_PER_USER="3"

# ── Feedback (the "?" button → /api/feedback) ─────────────────────────────────
# On by default and needs only a database. Every stored report emits a
# server-side feedback_received event, and a daily PostHog alert on it is the
# only notice a report arrived; it rides POSTHOG_KEY. Rate limits key on the
# user id when signed in, else the rl_fb cookie, never on IP: Railway's load
# balancer collapses every client into one address.

# 0 makes the endpoint 404.
# FEEDBACK_ENABLED="1"

# Cap on the request body, checked against actual bytes.
# FEEDBACK_MAX_BYTES="32768"

# Anonymous reports per hour.
# FEEDBACK_ANON_PER_HOUR="3"

# Anonymous reports per day.
# FEEDBACK_ANON_PER_DAY="10"

# Signed-in reports per hour.
# FEEDBACK_USER_PER_HOUR="15"

# Signed-in reports per day.
# FEEDBACK_USER_PER_DAY="50"

# Circuit breaker across all submitters: everyone gets 429 past it.
# FEEDBACK_GLOBAL_PER_DAY="500"

# Mirrors each accepted report into this PostHog survey (the uuid in its URL),
# after validation and rate limiting. Needs POSTHOG_KEY. Empty: no mirror;
# Postgres is the record either way.
# FEEDBACK_SURVEY_ID=""

# Question uuid within that survey, needed once it has several questions. Empty
# uses the single-question $survey_response property. Read it back with the
# public key:
#  curl -s "https://us.i.posthog.com/api/surveys/?token=$VITE_POSTHOG_KEY" \
#    | jq '.surveys[] | select(.id=="<survey-uuid>") | .questions[] | {id, question}'
# FEEDBACK_SURVEY_QUESTION_ID=""

# ── Local dev (pnpm dev) ──────────────────────────────────────────────────────
# Each skips one preflight step; see the root CLAUDE.md, Local dev.

# 1 skips the pnpm install check.
# DEV_NO_INSTALL=""

# 1 skips Docker and Postgres; the reader works from disk artifacts, and
# history, chat and previews need a database.
# DEV_NO_DB=""

# 1 brings the database up but skips the atlas sync; the server migrates at
# boot.
# DEV_NO_WORKER=""

# 1 skips the artifact build and the settlement and vote-record refreshes.
# DEV_NO_BUILD=""

# 1 skips only the settlement refresh.
# DEV_NO_SETTLEMENTS=""

# 1 skips only the vote-record refresh (public/votes.json).
# DEV_NO_VOTES=""

# ── Set by the platform ───────────────────────────────────────────────────────
# Railway and CI set these; set them by hand only to reproduce a deployment
# locally.

# Railway environment name. Read before RAILWAY_ENVIRONMENT; `production` turns
# on the canonical-host redirect and names the OpenRouter attribution bucket.
# RAILWAY_ENVIRONMENT_NAME=""

# The same name under the variable older Railway versions set.
# RAILWAY_ENVIRONMENT=""

# Public domain Railway assigns; APP_URL falls back to it.
# RAILWAY_PUBLIC_DOMAIN=""

# This app's commit, reported in tool response `_meta`. Falls back to
# APP_COMMIT, GIT_COMMIT, then SOURCE_COMMIT.
# RAILWAY_GIT_COMMIT_SHA=""

# App commit when RAILWAY_GIT_COMMIT_SHA is unset.
# APP_COMMIT=""

# App commit when neither of the above is set.
# GIT_COMMIT=""

# Last fallback for the app commit.
# SOURCE_COMMIT=""
