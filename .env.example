ETHERSCAN_API_KEY="" # https://etherscan.io/apidashboard

# ── Analytics (PostHog Cloud US — cookieless, IP-free, first-party /z proxy) ──
# Build-time frontend key (project "phc_..." key). The ONLY analytics config:
# present → analytics on; absent → fully disabled (no init, no /z traffic, no
# consent banner). The /z reverse proxy (src/server/posthog-proxy.ts) needs no
# key. One project serves dev + prod — every event carries host + environment
# super properties so dev can be filtered out. Set only for the Railway build
# (static GH/CF Pages builds have no proxy → leave empty there).
VITE_POSTHOG_KEY=""

# Runtime key for server-side capture (src/server/posthog-capture.ts) — MCP tool
# calls (POST /mcp), which never touch a browser so posthog-js can't fire them —
# AND for LLM observability: the /api/chat generations emit `$ai_generation` events
# via the @posthog/ai OpenAI wrapper (src/server/posthog-node.ts + llm.ts), keyed to
# the signed-in user, metadata-only (no prompt/response text). Same non-secret
# "phc_..." project key as VITE_POSTHOG_KEY above (PostHog has no separate "server"
# capture key), but this one must be a RUNTIME service variable — VITE_* vars are
# inlined at build time only, not read by the running Bun process. Absent → both
# server-side capture and AI observability are a silent no-op.
POSTHOG_KEY=""
# POSTHOG_HOST="https://us.i.posthog.com"   # override for EU cloud / self-hosted

# ── Railway MCP service ──────────────────────────────────────────────────────
# Copy needed vars to .env.local (gitignored). Bun auto-loads .env.local.

# Postgres. Local default matches docker-compose; Railway injects its own.
DATABASE_URL=
ATLAS_UPDATE_ENABLED=1

# OpenRouter — semantic search embeddings (sync:embeddings + query-time).
# Without this, semantic search is silently empty; lexical still works.
OPENROUTER_API_KEY=""

# OpenRouter MANAGEMENT/provisioning key (distinct from the model-call key above)
# for the account-wide credits endpoint that powers the chat's shared "commons"
# dollar meter. Without it, the commons meter is simply absent and the shared-pool
# gate never fires. Create under OpenRouter → Settings → Provisioning Keys.
OPENROUTER_MANAGEMENT_KEY=""

# ── Auth (GitHub / Google OAuth + JWT session) ───────────────────────────────
# The login surface turns on only when USERS_ENABLED=1 AND CHAT_JWT_SECRET is
# set (see src/server/config.ts). Configure ONE provider's pair to offer only
# that button, or both to offer both (src/lib/authProviders.ts).
USERS_ENABLED="1"
# Frontend build flag — must also be set at BUILD time so the login UI ships.
VITE_USERS_ENABLED="1"

# GitHub OAuth App (Settings → Developer settings → OAuth Apps).
# Authorization callback URL = <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth 2.0 Client (Google Cloud Console → APIs & Services → Credentials
# → Create credentials → OAuth client ID → Web application). Uses OpenID Connect
# with PKCE; scopes are openid, email, profile (non-sensitive — no Google app
# verification required). Authorized redirect URI (exact, no trailing slash):
#   <APP_URL>/api/auth/google/callback
# e.g. https://atlas.redline.support/api/auth/google/callback              (production)
#      https://redlens-development.up.railway.app/api/auth/google/callback (dev/staging)
#      http://localhost:3000/api/auth/google/callback                      (local dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Random secret signing the session JWT. Generate: openssl rand -hex 32
CHAT_JWT_SECRET=""

# Private atlas previews: a GitHub App (Contents:read + Metadata:read)
# installed on private repos. Leave blank to disable the feature.
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""

# Optional overrides (defaults in src/server/config.ts):
# PREVIEW_PRIVATE_DAILY_QUOTA="20"   # per-repo daily cap on NEW private-preview analyses

# Optional overrides (defaults in src/server/config.ts):
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# EMBED_MODEL="qwen/qwen3-embedding-8b"
# EMBED_BATCH="50"
# PORT="3000"
# MCP_PATH="/mcp"
# APP_URL="http://localhost:3000"   # public origin; Railway derives from RAILWAY_PUBLIC_DOMAIN.
#   REQUIRED (not optional) when more than one domain is attached to the service
#   (apex + subdomain): RAILWAY_PUBLIC_DOMAIN is then ambiguous and OAuth may
#   build its redirect_uri against the wrong domain. When appUrl is https, all
#   GET/HEAD traffic on other hosts is 301'd to this origin (src/server/canonical.ts).
#   That redirect only runs when RAILWAY_ENVIRONMENT_NAME is "production" — PR
#   environments inherit this pinned APP_URL and would 301 themselves to prod.
# CANONICAL_HOST_REDIRECT="0"       # force the canonical-host redirect off ("1" forces it on)
# CHAT_MODEL="deepseek/deepseek-v4-flash"
# Offline HTML-era curation models (scripts/htmlhist/*, never the runtime chat) — picked by the
# model bakeoff (scripts/htmlhist/curation-model-bakeoff.mjs). Defaults parsed in
# scripts/htmlhist/curation-models.mjs, NOT src/server/config.ts (unlike the rest of this section) —
# these four have zero runtime readers, only the offline htmlhist scripts.
# CURATION_SELECTOR_MODEL="mistralai/mistral-nemo"    # pass-2 LLM∩matcher proposer (best hard-acc/$)
# CURATION_CLUSTER_MODELS="deepseek/deepseek-v4-flash,anthropic/claude-haiku-4.5"  # cluster pass, CSV ≥2 families
# CURATION_FRONTIER_MODEL="deepseek/deepseek-v4-pro"  # pass-3 escalation (--frontier), highest accuracy
# CURATION_AUDIT_MODEL="google/gemma-4-31b-it"        # independent decision auditor (different family)
# RATE_LIMIT_TOKENS_PER_WINDOW="500000"  # per-user input+output token budget per window (~60-80 queries)
# RATE_LIMIT_WINDOW_MINUTES="120"       # fixed-clock window length (2h)

# ── Chat (defaults in src/server/config.ts) ──────────────────────────────────
# CHAT_MODEL="deepseek/deepseek-v4-flash"       # primary conversationalist model
# CHAT_TEMPERATURE="0.3"                         # sampling temperature for the chat model
# CHAT_MAX_OUTPUT_TOKENS="16000"                 # runaway-generation safety cap, not a display limit
# CHAT_MAX_ITERATIONS="4"                        # server-side cap on agentic tool rounds
# CHAT_TOOL_RESULT_MAX_CHARS="30000"             # per-tool-result budget fed back to the model
# Capture raw prompt/response text on PostHog $ai_generation events (not just
# token/latency/cost). ON by default; set to 0 for metadata-only:
# CHAT_CAPTURE_CONTENT="1"
# Per-turn model routing (CSV: primary,fallback1,… — unset tiers inherit CHAT_MODEL):
# Small-talk bypass judge: one tiny question-side classification that gates
# skipping the verification harness for pure greetings. Empty (default) =
# bypass disabled — every turn gets the full audit. Chat-tier is plenty:
# CHAT_SMALLTALK_JUDGE_MODEL="google/gemma-4-31b-it"
# CHAT_MODEL_FAST=""
# CHAT_MODEL_STRONG=""
# CHAT_MODEL_FALLBACKS=""
# Models PROMPTED for reference-style citations (definition block + [text][label]).
# Defaults to CHAT_MODEL_STRONG; every model accepts both formats either way.
# CHAT_REFERENCE_CITATION_MODELS=""

# Cheap 3-6 word conversation titles, written after assistant turns 1, 4 and 10
# (a manual rename freezes the title permanently). Unlike the harness models
# below, this DEFAULTS ON — set the model to "" to turn titling off, and
# conversations keep the first 60 chars of their opening message instead.
# The timeout is generous because the call fires after the response has already
# closed: it costs no user latency and only bounds a hung request.
# CHAT_TITLE_MODEL="google/gemma-4-31b-it"
# CHAT_TITLE_TIMEOUT_MS="20000"                  # hard cap → existing title kept on timeout

# ── Chat reliability harness (docs/plans/chat-reliability-harness.md) ─────────
# Final claim-audit model — a stronger, DIFFERENT-family model than CHAT_MODEL.
# Empty = model verification off (deterministic checks still run):
# CHAT_MODEL="google/gemma-4-31b-it"
# CHAT_MODEL_FALLBACKS="z-ai/glm-5.2,anthropic/claude-haiku-4.5"
# CHAT_MODEL_STRONG="openai/gpt-5-mini"
# CHAT_ADVISOR_MODEL="anthropic/claude-haiku-4.5"
# CHAT_VERIFY_CHECKS="1"                          # deterministic checks (free); set 0 to disable
# CHAT_PREFETCH="1"                               # glossary/entity pre-lookup round; set 0 to disable
# CHAT_VERIFIER_EVIDENCE_MAX_CHARS="60000"       # evidence digest budget for the audit
# CHAT_VERIFIER_TIMEOUT_MS="20000"               # hard cap on the verifier call → "unverified" on timeout
# CHAT_ADVISOR_TRIGGER_EMPTY_RESULTS="2"         # ≥N empty/error tool results escalates to the advisor
# CHAT_ADVISOR_TRIGGER_UNSUPPORTED_CLAIMS="3"    # ≥N unsupported claims before a warn escalates (a revision replays the whole transcript)
# CHAT_ADVISOR_TIMEOUT_MS="8000"                 # hard cap on the advisor call → annotate-only on timeout

# ── Feedback (the "?" button → /api/feedback; defaults in src/server/config.ts) ─
# All optional — the endpoint is ON by default and needs only a database.
# FEEDBACK_ENABLED="0"                           # set to "0" to 404 the endpoint
# FEEDBACK_MAX_BYTES="32768"                     # hard cap on the request body
# Rate limits are keyed on the user id when signed in, else the random `rl_fb`
# cookie minted on the first submission. Anonymous is deliberately tighter.
# Never keyed on IP: Railway's load balancer collapses every client into one
# address (see docs/reviews/2026-07-09-deep-code-review.md).
# FEEDBACK_ANON_PER_HOUR="3"
# FEEDBACK_ANON_PER_DAY="10"
# FEEDBACK_USER_PER_HOUR="15"
# FEEDBACK_USER_PER_DAY="50"
# FEEDBACK_GLOBAL_PER_DAY="500"                  # circuit breaker: 429s everyone past this
# Optional PostHog Surveys mirror. The server forwards a "survey sent" event
# AFTER validation and rate limiting, so spam never reaches PostHog and never
# burns the response quota. Empty = no forward; Postgres is the record either way.
# Needs POSTHOG_KEY set too — this is the server-side client, not VITE_POSTHOG_KEY.
# FEEDBACK_SURVEY_ID=""                          # survey uuid — it's in the survey's PostHog URL
# The question uuid is OPTIONAL: leave it empty and a single-question survey
# uses PostHog's legacy un-suffixed `$survey_response` property. Set it to key
# the answer by question id (required once a survey has several questions).
# PostHog doesn't show the question uuid in its UI — read it back with the
# public project key, the same endpoint posthog-js calls (survey must be enabled):
#   curl -s "https://us.i.posthog.com/api/surveys/?token=$VITE_POSTHOG_KEY" \
#     | jq '.surveys[] | select(.id=="<survey-uuid>") | .questions[] | {id, question}'
# FEEDBACK_SURVEY_QUESTION_ID=""                 # question uuid within that survey
